# ===== AI要約（未設定ならお試し表示で動作）=====
ANTHROPIC_API_KEY=
# 省略時は claude-sonnet-5-5（元の MediKataru と同じ。コスト重視）。精度を上げたいときは claude-opus-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# 考える深さ low / medium / high（省略時 medium）。上げるほど精度とコストが上がる
# ANTHROPIC_EFFORT=medium
# 1件あたりの費用表示に使う為替（省略時 150円/ドル）
# USD_JPY=150
# 待ち受けるポート（省略時 3000）
# PORT=3000

# ===== 管理者（医師）の確認 =====
# 管理者の画面を開く合言葉。未設定なら管理者の画面は開けない（AIの報告の保存は続く）
# ADMIN_PASSWORD=
# 報告と用語辞書の保存先（Turso）。未設定なら ./data/feedback.db（開発用）
# TURSO_DATABASE_URL=libsql://medikataru-pet-xxxx.turso.io
# TURSO_AUTH_TOKEN=
